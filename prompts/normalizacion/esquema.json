{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Normalización de nombres de productos escritos por comerciantes (San Camilo en Línea)",
  "type": "object",
  "required": ["resultados"],
  "additionalProperties": false,
  "properties": {
    "resultados": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["entrada", "producto", "confianza"],
        "additionalProperties": false,
        "properties": {
          "entrada": {"type": "string"},
          "producto": {"type": "string", "minLength": 1, "maxLength": 40},
          "confianza": {"enum": ["alta", "media", "baja"]}
        }
      }
    }
  }
}
