@startuml
set separator none
title San Camilo en Línea - Containers

left to right direction

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

Person(Cliente, "Cliente", $descr="Compra productos de varios puestos de un mercado (San Camilo, Altiplano o Río Seco) en un solo pedido, con recojo o delivery.", $tags="", $link="")
Person(Comerciante, "Comerciante", $descr="Dueño o encargado de un puesto de San Camilo, Altiplano o Río Seco; publica sus productos y atiende su parte de cada pedido.", $tags="", $link="")
Person(Administradordemercado, "Administrador de mercado", $descr="Configura las reglas de su mercado: pedido mínimo, zonas de delivery, medios de pago y horario [QA-08].", $tags="", $link="")
Person(Repartidor, "Repartidor", $descr="Recoge los productos en los puestos y los entrega al cliente.", $tags="", $link="")
System(Proveedordepagos, "Proveedor de pagos", $descr="Procesa el cobro con Yape o Plin; Yape no ofrece una API pública abierta (R-05).", $tags="", $link="")
System(WhatsAppBusinessPlatform, "WhatsApp Business Platform", $descr="Entrega al comerciante la confirmación de su parte del pedido (plantillas aprobadas).", $tags="", $link="")

System_Boundary("SanCamiloenLínea_boundary", "San Camilo en Línea", $tags="") {
  Container(SanCamiloenLínea.Worker, "Worker", $techn="Celery", $descr="Envía los avisos pendientes a WhatsApp [QA-03] y reintenta cada minuto los pagos pendientes de la outbox [QA-09].", $tags="", $link="")
  Container(SanCamiloenLínea.Planificador, "Planificador", $techn="Celery beat", $descr="Programa cada minuto los reintentos de pagos y cada 5 min los de avisos; cancela los pedidos sin pago a los 15 min [QA-09].", $tags="", $link="")
  ContainerQueue(SanCamiloenLínea.Colaycaché, "Cola y caché", $techn="Redis", $descr="Broker de tareas de Celery y caché del catálogo [QA-04].", $tags="", $link="")
  ContainerDb(SanCamiloenLínea.Basededatos, "Base de datos", $techn="PostgreSQL 16 + RLS", $descr="Un esquema por módulo. Columna mercado_id con Row-Level Security e índices por mercado [QA-04, QA-05]; outbox de pagos y avisos en la misma transacción que el pedido [QA-03, QA-09].", $tags="", $link="")
  Container(SanCamiloenLínea.PWAofflinefirst, "PWA offline-first", $techn="Plantillas Django + JavaScript, Service Worker, IndexedDB", $descr="Interfaz de cliente, comerciante y repartidor. Publica un producto en 3 toques y guarda las acciones sin conexión para sincronizarlas después [QA-02].", $tags="", $link="")
  Container(SanCamiloenLínea.APISanCamilo, "API San Camilo", $techn="Python / Django + Gunicorn (5 workers)", $descr="Monolito modular con 6 módulos de dominio. Cada petición fija el mercado del claim del token antes de consultar la BD [QA-05].", $tags="", $link="")
}

Rel(WhatsAppBusinessPlatform, Comerciante, "Entrega el aviso del pedido en su WhatsApp", $techn="", $tags="", $link="")
Rel(Cliente, SanCamiloenLínea.PWAofflinefirst, "Explora el catálogo, arma su pedido y paga", $techn="HTTPS", $tags="", $link="")
Rel(Comerciante, SanCamiloenLínea.PWAofflinefirst, "Publica productos y marca agotados, incluso sin conexión", $techn="HTTPS", $tags="", $link="")
Rel(Administradordemercado, SanCamiloenLínea.PWAofflinefirst, "Edita las reglas de su mercado", $techn="HTTPS", $tags="", $link="")
Rel(Repartidor, SanCamiloenLínea.PWAofflinefirst, "Consulta su ruta y marca entregas", $techn="HTTPS", $tags="", $link="")
Rel(SanCamiloenLínea.PWAofflinefirst, SanCamiloenLínea.APISanCamilo, "Envía solicitudes y sincroniza las acciones guardadas", $techn="HTTPS/JSON (con clave de idempotencia)", $tags="", $link="")
Rel(SanCamiloenLínea.APISanCamilo, SanCamiloenLínea.Basededatos, "Lee y escribe con el mercado del token (RLS)", $techn="SQL/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.APISanCamilo, SanCamiloenLínea.Colaycaché, "Cachea el catálogo y encola los envíos", $techn="Redis protocol", $tags="", $link="")
Rel(SanCamiloenLínea.Worker, SanCamiloenLínea.Colaycaché, "Consume las tareas de envío", $techn="Redis protocol", $tags="", $link="")
Rel(SanCamiloenLínea.Worker, SanCamiloenLínea.Basededatos, "Lee la outbox de avisos y de pagos pendientes", $techn="SQL/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.Worker, Proveedordepagos, "Reintenta los pagos pendientes", $techn="HTTPS/JSON", $tags="", $link="")
Rel(SanCamiloenLínea.Planificador, SanCamiloenLínea.Colaycaché, "Programa los reintentos de pagos (1 min) y de avisos (5 min)", $techn="Redis protocol", $tags="", $link="")
Rel(SanCamiloenLínea.Worker, WhatsAppBusinessPlatform, "Envía la confirmación al comerciante", $techn="HTTPS/JSON", $tags="", $link="")
Rel(SanCamiloenLínea.APISanCamilo, Proveedordepagos, "Solicita el cobro con reintentos y circuit breaker", $techn="HTTPS/JSON", $tags="", $link="")
Rel(Proveedordepagos, SanCamiloenLínea.APISanCamilo, "Notifica el resultado del cobro (webhook idempotente)", $techn="HTTPS/JSON", $tags="", $link="")

SHOW_LEGEND(true)
@enduml