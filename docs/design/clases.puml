@startuml clases-pedidos
' San Camilo en Línea — Diagrama de clases de diseño
' Lab 05 (E1) actualizado en el Lab 07 (E7) con los patrones de diseño aplicados al código.
' Convención (regla C5 del Lab 05): camelCase aquí = snake_case en Python (calcularTotal = calcular_total).
' Arquitectura: ADR-001 (monolito modular), ADR-002 (estados), ADR-004 (puertos neutrales), ADR-005 (patrones).
' Los estados concretos (State) se detallan en docs/design/patrones/state.puml.
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 110
skinparam packageStyle rectangle
skinparam classBackgroundColor #EEF2F8
skinparam classBorderColor #1A3A5C
skinparam packageBorderColor #7F7F7F
skinparam nodesep 30
skinparam ranksep 45
hide empty members
title San Camilo en Línea — Diseño de clases con patrones (Lab 05 actualizado en el Lab 07)

package "pedidos" {
  class Cliente {
    - nombre: String
    - celular: String
    - direccion: String
  }
  abstract class ItemPedido <<Composite>> {
    + subtotal(): Decimal
  }
  class Pedido <<Composite raíz>> {
    - id: UUID
    - codigo: String
    - tipoEntrega: TipoEntrega
    - distrito: String [0..1]
    - costoEnvio: Decimal
    - medioPago: String [0..1]
    + agregarLinea(producto: Producto, cantidad: Decimal): void
    + subtotal(): Decimal
    + total(): Decimal
    + lineas(): Iterator<LineaPedido>
    + subpedidoDe(comerciante: Comerciante): PedidoPuesto
    + confirmar(): void
    + registrarPago(pago: Pago): void
    + cancelar(motivo: String): void
    + marcarPreparado(): void
    + marcarEnCamino(): void
    + marcarEntregado(): void
    ~ cambiarA(nuevo: EstadoPedido): void
  }
  class PedidoPuesto <<Composite>> {
    - id: UUID
    - motivoRechazo: String [0..1]
    + subtotal(): Decimal
    + recibir(): void
    + marcarListo(): void
    + rechazar(motivo: String): void
    + marcarRecogido(repartidorId: UUID, codigoRecojo: String): void
    + marcarEntregado(): void
    + anular(): void
    ~ cambiarA(nuevo: EstadoPedidoPuesto): void
  }
  class LineaPedido <<Leaf>> {
    - cantidad: Decimal
    - precioUnitario: Decimal
    + subtotal(): Decimal
  }
  abstract class EstadoPedido <<State>> {
    + nombre: String
  }
  abstract class EstadoPedidoPuesto <<State>> {
    + nombre: String
  }
  enum TipoEntrega {
    RECOJO_MERCADO
    DELIVERY
  }
  interface TarifaEnvio <<Strategy>> {
    + calcular(subtotal: Decimal, distrito: String): Decimal
  }
  class TarifaRecojo
  class TarifaPorZona
  class ServicioPedidos <<servicio>> {
    + confirmarYPagar(pedido: Pedido, medio: String, codigoAprobacion: String): String
    + procesarWebhookPago(pedido: Pedido, pago: Pago): void
    + cancelarPorTiempoAgotado(pedido: Pedido): void
    + rechazarPuesto(pedido: Pedido, comerciante: Comerciante, motivo: String): String
  }
  interface RepositorioPedidos <<puerto>> {
    + buscarPorId(id: UUID): Pedido
    + guardar(pedido: Pedido): void
  }
}

package "catalogo" {
  class Comerciante {
    - nombre: String
    - numeroPuesto: String
    - celular: String
  }
  class Producto {
    - nombre: String
    - precio: Decimal
    - stockDisponible: Decimal
    + reservar(cantidad: Decimal): void
    + liberar(cantidad: Decimal): void
  }
  class NormalizadorNombres {
    + sugerirNombre(nombre: String, proveedor: String): String [0..1]
  }
  interface ProveedorLLM <<Strategy>> {
    + completar(prompt: String): String
  }
  abstract class Guardrail <<Chain of Responsibility>> {
    + validar(texto: String): String
  }
}

package "pagos" {
  class Pago {
    - pedidoId: UUID
    - monto: Decimal
    - referenciaProveedor: String [0..1]
    - estado: EstadoPago
    + estaConfirmado(): Boolean
  }
  enum EstadoPago {
    PENDIENTE
    CONFIRMADO
    RECHAZADO
    EXPIRADO
  }
  interface PasarelaPago <<Strategy / puerto>> {
    + iniciarCobro(pedidoId: UUID, monto: Decimal, celular: String, codigoAprobacion: String): Pago
    + reembolsar(referenciaProveedor: String, monto: Decimal): void
  }
  class YapeAdapter <<Adapter>>
  class PlinAdapter <<Adapter>>
  class ConReintentos <<Decorator>>
  class FabricaPasarelas <<Factory>> {
    + registrar(medio: String, creador: Callable): void
    + crear(medio: String): PasarelaPago
  }
}

package "comun" {
  class PublicadorEventos <<Observer: sujeto>> {
    + suscribir(evento: String, suscriptor: Suscriptor): void
    + publicar(evento: String, datos: Map): void
  }
  interface Suscriptor <<Observer>> {
    + actualizar(evento: String, datos: Map): void
  }
}

package "notificaciones" {
  interface NotificadorMensajeria <<puerto>> {
    + notificarComerciante(celular: String, resumen: String): void
    + notificarCliente(celular: String, mensaje: String): void
  }
  class NotificadorComerciantes
  class NotificadorCliente
}

package "reparto" {
  class Repartidor {
    + tomarPedido(pedido: Pedido): void
  }
  class AsignadorReparto
}

' --- Composite (multiplicidades del Lab 05, regla C3) ---
ItemPedido <|-- Pedido
ItemPedido <|-- PedidoPuesto
ItemPedido <|-- LineaPedido
Pedido "1" *-- "1..*" PedidoPuesto : se divide en >
PedidoPuesto "1" *-- "1..*" LineaPedido : contiene >
Pedido "0..*" --> "1" Cliente : pertenece a >
LineaPedido "0..*" --> "1" Producto : referencia >
PedidoPuesto "0..*" --> "1" Comerciante : lo atiende >
Producto "0..*" --> "1" Comerciante : publicado por >
Pedido "1" --> "0..1" Pago : se paga con >
Pedido --> TipoEntrega
Repartidor "0..1" --> "0..*" Pedido : reparte >

' --- State ---
Pedido o--> "1" EstadoPedido : estado actual
PedidoPuesto o--> "1" EstadoPedidoPuesto : estado actual

' --- Strategy, Adapter, Decorator, Factory ---
TarifaEnvio <|.. TarifaRecojo
TarifaEnvio <|.. TarifaPorZona
PasarelaPago <|.. YapeAdapter
PasarelaPago <|.. PlinAdapter
PasarelaPago <|.. ConReintentos
ConReintentos o--> "1" PasarelaPago : envuelve
FabricaPasarelas ..> PasarelaPago : crea
Pago --> EstadoPago
NormalizadorNombres o--> "1..*" ProveedorLLM
NormalizadorNombres --> "1" Guardrail : primer eslabón

' --- Observer ---
PublicadorEventos o--> "0..*" Suscriptor
Suscriptor <|.. NotificadorComerciantes
Suscriptor <|.. NotificadorCliente
Suscriptor <|.. AsignadorReparto
NotificadorComerciantes ..> NotificadorMensajeria
NotificadorCliente ..> NotificadorMensajeria

' --- Servicio ---
ServicioPedidos ..> Pedido
ServicioPedidos ..> FabricaPasarelas
ServicioPedidos o--> "1..*" TarifaEnvio
ServicioPedidos ..> PublicadorEventos : publica
ServicioPedidos ..> RepositorioPedidos

note bottom of PublicadorEventos
  Lab 07: pedidos ya no depende de notificaciones:
  publica eventos con datos neutrales y los suscriptores
  se conectan en arranque.py (raíz de composición).
end note
@enduml
